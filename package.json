{
  "name": "seguros-correo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "dev:up": "bash scripts/dev-up.sh",
    "dev:down": "docker compose -f docker/compose.dev.yml down",
    "dev:reset": "docker compose -f docker/compose.dev.yml down --volumes",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "check": "pnpm lint && pnpm typecheck && pnpm format:check && pnpm test",
    "check:all": "pnpm check && pnpm test:integration",
    "reflejo": "tsx apps/server/scripts/reflejo.ts",
    "cuenta": "tsx apps/server/scripts/cuenta.ts",
    "servidor": "tsx apps/server/src/main.ts",
    "usuario": "tsx apps/server/scripts/usuario.ts",
    "build": "pnpm --filter @correo/web build",
    "web": "pnpm --filter @correo/web dev",
    "reprocesar": "tsx apps/server/scripts/reprocesar.ts",
    "sembrar": "tsx apps/server/scripts/sembrar.ts",
    "demo": "tsx apps/server/scripts/demo.ts",
    "whatsapp-simulador": "tsx apps/server/scripts/whatsapp-simulador.ts",
    "banco-ocr": "tsx --env-file-if-exists=.env apps/server/scripts/banco-ocr.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.0.0",
    "prettier": "^3.10.0",
    "tsx": "^4.23.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  }
}
