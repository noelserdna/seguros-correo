# Valores por defecto del entorno de desarrollo (pnpm dev:up).
# Copiar a .env solo si hace falta cambiarlos.

DATABASE_URL=postgres://correo:correo@127.0.0.1:54329/correo

# Servidor de correo de pruebas (docker-mailserver)
TEST_IMAP_HOST=127.0.0.1
TEST_IMAP_PORT=1993
TEST_SMTP_HOST=127.0.0.1
TEST_SMTP_PORT=1587
TEST_MAIL_PASSWORD=prueba-1234

# Acceso con cuenta de Google y de Microsoft 365 (opcional).
# Dirección de vuelta que hay que registrar: http://127.0.0.1:3000/api/oauth/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# PUBLIC_URL=http://127.0.0.1:3000

# Módulos opcionales, separados por comas: expedientes, tramitacion (necesita expedientes), ocr (texto de fotos y escaneados).
PLUGINS=

# Solo para probar modelos de visión con `pnpm banco-ocr`. La aplicación no la usa.
OPENROUTER_API_KEY=

# Módulo «vision»: lee fotos y escaneados con un modelo de visión, en cola. Para las
# pruebas se usa OpenRouter (los documentos salen a un servicio externo); en producción,
# un servidor en la propia oficina con la misma API (llama.cpp, vLLM, MLX).
# VISION_API_URL=https://openrouter.ai/api/v1
# VISION_API_KEY=
# VISION_MODEL=qwen/qwen3-vl-8b-instruct
# VISION_CONCURRENCY=2
# VISION_MAX_PAGES=10

# Módulo whatsapp (añadir «whatsapp» a PLUGINS): los mensajes del número de empresa se guardan
# como correos en una carpeta del buzón indicado, un hilo por contacto. Con la API de WhatsApp
# Business de Meta en coexistencia. Para probar en local: pnpm whatsapp-simulador.
# WHATSAPP_MAILBOX=siniestros@correo.test
# WHATSAPP_FOLDER=WhatsApp
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_GRAPH_URL=https://graph.facebook.com/v21.0
